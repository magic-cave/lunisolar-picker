{
  "name": "@lunisolar-picker/theme",
  "version": "0.2.1",
  "description": "Mono theme for lunisolar-picker parts",
  "keywords": [
    "lunisolar-picker",
    "datepicker",
    "theme",
    "css",
    "dark-mode",
    "shadcn"
  ],
  "license": "MIT",
  "author": {
    "name": "kubrickcode",
    "url": "https://github.com/kubrickcode"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magic-cave/lunisolar-picker.git",
    "directory": "packages/theme"
  },
  "homepage": "https://lunisolar.magic-cave.com/",
  "bugs": {
    "url": "https://github.com/magic-cave/lunisolar-picker/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    "./mono.css": "./src/mono.css",
    "./bridge/shadcn.css": "./src/bridge/shadcn.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "package-check": "publint --strict"
  },
  "devDependencies": {
    "@lunisolar-picker/react": "workspace:*"
  }
